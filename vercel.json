{
  "buildCommand": "node generate-media.js",
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noimageindex, noarchive, nosnippet, notranslate"
        },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ]
}
